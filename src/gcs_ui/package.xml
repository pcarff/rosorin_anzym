<?xml version="1.0"?>
<?xml-model href="http://ros.org" schematypens="http://w3.org"?>
<package format3>
  <name>gcs_ui</name>
  <version>1.0.0</version>
  <description>ROS2-Native Qt6 Ground Control Station User Interface</description>
  <maintainer email="user@example.com">Developer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS2 Dependencies -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>

  <!-- Qt6 System Package Dependencies -->
  <build_depend>qtbase5-dev</build_depend> <!-- Or qt6-base-dev depending on Ubuntu distro package naming -->
  
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
